# --- LLM (OpenAI-compatible endpoint mana pun, mis. Ollama: http://localhost:11434/v1) ---
LLM_BASE_URL=https://api.b.ai/v1
LLM_API_KEY=***
LLM_MODEL=qwen3.8-flash

# --- GitHub ---
# PAT klasik dengan scope `repo` (+ `admin:repo_hook` untuk mode attach)
GH_TOKEN=
*** daftar repo yang dipantau, dipisah koma
REPOS=owner/repo1,owner/repo2

# --- Webhook real-time (opsional; polling tetap jalan sebagai cadangan) ---
# harus URL publik yang menunjuk ke `node index.js serve`, akhiran /webhook
WEBHOOK_URL=http://IP-PUBLIK-KAMU/webhook
WEBHOOK_PORT=80

# --- Lain-lain ---
POLL_INTERVAL_MS=180000
# folder penyimpanan state (.gazer-state.json / .gazer-webhooks.json)
# berguna saat jalan di Docker dengan volume mount
# GAZER_STATE_DIR=/app/data
# timeout panggilan LLM (ms)
# LLM_TIMEOUT_MS=90000
